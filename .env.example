# Dedicated Event Beast project only. Never use another application's database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_EVENT_SLUG=momentum-builder-live-2026
# Explicit opt-in. Never enable demo mode on the live attendee deployment.
EVENT_BEAST_DEMO_MODE=false
# Public information site is now the default. Set false only for legacy regression/rollback.
EVENT_BEAST_PUBLIC_SITE=true
# Enable only after custom SMTP and real inbox delivery are verified.
EVENT_BEAST_EMAIL_READY=false
# Password recovery can be qualified and opened independently of bulk account/signup email.
EVENT_BEAST_RECOVERY_READY=false
# Optional: local Postgres/Supabase test connection only (never commit credentials).
TEST_DATABASE_URL=

# Agency/customer workspace rollout. Enable after migrations and owner assignment.
EVENT_BEAST_PLATFORM_ENABLED=false
# Trusted workspace origin for verification/recovery; align with Auth redirects.
EVENT_BEAST_PLATFORM_URL=http://localhost:3100
# Optional workspace overrides; keep legacy event email delivery independent.
EVENT_BEAST_WORKSPACE_EMAIL_READY=false
EVENT_BEAST_WORKSPACE_RECOVERY_READY=false

# Paid subscriptions: keep disabled until the isolated and Stripe test checks pass.
EVENT_BEAST_BILLING_ENABLED=false
EVENT_BEAST_BILLING_MODE=test
# Server-only Stripe key and snapshot-event webhook signing secret.
EVENT_BEAST_STRIPE_SECRET_KEY=
EVENT_BEAST_STRIPE_WEBHOOK_SECRET=
# Explicit customer portal configuration: payment methods, invoices, cancellation.
# Subscription plan changes in the portal must be disabled for this release.
EVENT_BEAST_STRIPE_PORTAL_CONFIGURATION=
# Dedicated event_beast_billing role; never postgres or a Supabase service key.
# Use a direct/pooler connection with that role. Do not append sslmode parameters.
EVENT_BEAST_BILLING_DATABASE_URL=
# Optional trusted PEM certificate; remote TLS verification is always enabled.
EVENT_BEAST_BILLING_DATABASE_CA=
